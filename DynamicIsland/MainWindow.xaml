<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Width="184" Height="34">

    <Border x:Name="Island"
            Background="#F7000000"
            CornerRadius="17"
            ClipToBounds="True"
            MouseEnter="Island_MouseEnter"
            MouseLeave="Island_MouseLeave"
            MouseLeftButtonDown="Island_MouseLeftButtonDown"
            MouseMove="Island_MouseMove"
            PreviewMouseLeftButtonUp="Island_PreviewMouseLeftButtonUp"
            MouseLeftButtonUp="Island_MouseLeftButtonUp">

        <Grid x:Name="Root">

            <!-- Collapsed: clock, weather, battery and the privacy dots -->
            <StackPanel x:Name="IdleView"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

              <!-- Row 1: always there, exactly the collapsed pill's height -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="34">

                <Ellipse x:Name="PlayingDot"
                         Width="6" Height="6"
                         Fill="#FF4ADE80"
                         VerticalAlignment="Center"
                         Margin="0,0,9,0"
                         Visibility="Collapsed"/>

                <TextBlock x:Name="IdleClock"
                           Text="00:00"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="IdleDate"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="8,1,0,0"/>

                <Border x:Name="WeatherSeparator"
                        Width="1" Height="14"
                        Background="{StaticResource Divider}"
                        Margin="11,0,11,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>

                <TextBlock x:Name="IdleWeatherGlyph"
                           FontFamily="Segoe UI Emoji"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="IdleTemperature"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           Visibility="Collapsed"/>

                <Border x:Name="BatterySeparator"
                        Width="1" Height="14"
                        Background="{StaticResource Divider}"
                        Margin="11,0,11,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>

                <TextBlock x:Name="IdleBatteryGlyph"
                           Style="{StaticResource IconFont}"
                           FontSize="12"
                           Foreground="{StaticResource TextMuted}"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="IdleBattery"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="5,0,0,0"
                           Visibility="Collapsed"/>

                <Ellipse x:Name="CameraDot"
                         Width="8" Height="8"
                         Fill="#FF22C55E"
                         VerticalAlignment="Center"
                         Margin="11,0,0,0"
                         ToolTip="Câmera em uso"
                         Visibility="Collapsed"/>

                <Ellipse x:Name="MicrophoneDot"
                         Width="8" Height="8"
                         Fill="#FFF59E0B"
                         VerticalAlignment="Center"
                         Margin="7,0,0,0"
                         ToolTip="Microfone em uso"
                         Visibility="Collapsed"/>

              </StackPanel>

              <!-- Row 2: the next calendar event, only when it starts within ReminderMinutes -->
              <StackPanel x:Name="EventRow"
                          Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          Height="28"
                          Visibility="Collapsed">

                  <!-- A drawn calendar icon (white tile, blue top, the event's day), not the official logo -->
                  <Border Width="17" Height="17"
                          CornerRadius="4"
                          Background="White"
                          ClipToBounds="True"
                          VerticalAlignment="Center">
                      <Grid>
                          <Border Height="5" VerticalAlignment="Top" Background="#FF4285F4"/>
                          <TextBlock x:Name="EventDay"
                                     FontSize="9.5"
                                     FontWeight="Bold"
                                     Foreground="#FF4285F4"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,1"/>
                      </Grid>
                  </Border>

                  <TextBlock x:Name="IdleEvent"
                             Foreground="{StaticResource TextPrimary}"
                             FontSize="12.5"
                             MaxWidth="280"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"/>
              </StackPanel>

            </StackPanel>

            <!-- Expanded: now playing -->
            <Grid x:Name="MediaView" Visibility="Collapsed" Margin="12,10,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="64" Height="64" Background="#FF1A1A1A">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,64,64" RadiusX="10" RadiusY="10"/>
                    </Border.Clip>
                    <Grid>
                        <TextBlock Text="&#xE768;"
                                   Style="{StaticResource IconFont}"
                                   FontSize="20"
                                   Foreground="{StaticResource TextFaint}"/>
                        <Image x:Name="Artwork" Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,10,0">
                    <TextBlock x:Name="TrackTitle"
                               Foreground="White"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TrackArtist"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11.5"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,8"/>
                    <Grid Height="3">
                        <Border CornerRadius="1.5" Background="{StaticResource Track}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ProgressDone" Width="0*"/>
                                <ColumnDefinition x:Name="ProgressLeft" Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="1.5" Background="#FFE8E8E8"/>
                        </Grid>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE892;"
                               Style="{StaticResource MediaButton}"
                               MouseLeftButtonUp="Previous_Click"/>
                    <TextBlock x:Name="PlayPauseGlyph"
                               Text="&#xE768;"
                               Style="{StaticResource MediaButtonPrimary}"
                               MouseLeftButtonUp="PlayPause_Click"/>
                    <TextBlock Text="&#xE893;"
                               Style="{StaticResource MediaButton}"
                               MouseLeftButtonUp="Next_Click"/>
                </StackPanel>
            </Grid>

            <!-- Expanded: volume / brightness / battery readout -->
            <Grid x:Name="OsdView" Visibility="Collapsed" Margin="18,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="OsdGlyph"
                           Grid.Column="0"
                           Text="&#xE767;"
                           Style="{StaticResource IconFont}"
                           FontSize="15"
                           Foreground="White"/>

                <Grid Grid.Column="1" Height="5" Margin="13,0,13,0" VerticalAlignment="Center">
                    <Border CornerRadius="2.5" Background="{StaticResource Track}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="OsdDone" Width="0*"/>
                            <ColumnDefinition x:Name="OsdLeft" Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="2.5" Background="White"/>
                    </Grid>
                </Grid>

                <TextBlock x:Name="OsdLabel"
                           Grid.Column="2"
                           Text="0%"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           MinWidth="34"/>
            </Grid>

            <!-- Pinned: calendar / weather / hardware -->
            <Grid x:Name="PanelView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,7,10,2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock x:Name="TabCalendar"
                                   Text="&#xE787;"
                                   Style="{StaticResource TabIcon}"
                                   ToolTip="Calendário"
                                   MouseLeftButtonUp="TabCalendar_Click"/>
                        <TextBlock x:Name="TabWeather"
                                   Text="&#xE753;"
                                   Style="{StaticResource TabIcon}"
                                   ToolTip="Tempo"
                                   MouseLeftButtonUp="TabWeather_Click"/>
                        <TextBlock x:Name="TabHardware"
                                   Text="&#xE713;"
                                   Style="{StaticResource TabIcon}"
                                   ToolTip="Hardware"
                                   MouseLeftButtonUp="TabHardware_Click"/>
                        <TextBlock x:Name="TabVolume"
                                   Text="&#xE767;"
                                   Style="{StaticResource TabIcon}"
                                   ToolTip="Volume"
                                   MouseLeftButtonUp="TabVolume_Click"/>
                        <TextBlock x:Name="TabMessages"
                                   Text="&#xE8F2;"
                                   Style="{StaticResource TabIcon}"
                                   ToolTip="Mensagens"
                                   MouseLeftButtonUp="TabMessages_Click"/>
                    </StackPanel>

                    <!-- One dot per enabled tab, the current one lit -->
                    <StackPanel x:Name="TabDots"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,34,0"/>

                    <TextBlock Text="&#xE711;"
                               Style="{StaticResource TabIcon}"
                               HorizontalAlignment="Right"
                               ToolTip="Fechar"
                               MouseLeftButtonUp="ClosePanel_Click"/>
                </Grid>

                <ContentControl x:Name="PanelHost" Grid.Row="1"/>
            </Grid>

            <!-- A toast from the watched app -->
            <Grid x:Name="MessageView" Visibility="Collapsed" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                        Background="#FF25D366" VerticalAlignment="Center">
                    <TextBlock x:Name="MessageInitial"
                               Foreground="#FF0A0A0A"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,0,0">
                    <TextBlock x:Name="MessageSender"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MessagePreview"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11.5"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Hover: one card per live function -->
            <ContentControl x:Name="OverviewHost" Visibility="Collapsed"/>

        </Grid>
    </Border>
</Window>
