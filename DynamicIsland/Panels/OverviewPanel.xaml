<UserControl x:Class="DynamicIsland.Panels.OverviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Card" Color="#FF121212"/>
        <SolidColorBrush x:Key="CardHover" Color="#FF191919"/>
        <SolidColorBrush x:Key="Hairline" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="Google" Color="#FF4285F4"/>

        <Style x:Key="CardShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,15,18,17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9A9A9A"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF0F0F0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="MetricCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6A6A6A"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="10,8,10,10">

        <!-- Pill header. Mirrors the collapsed pill, which the window keeps in
             step, because one control cannot live in two places at once. -->
        <Border Background="#FF0A0A0A" CornerRadius="17" Height="34"
                HorizontalAlignment="Center" Padding="16,0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Clock" Foreground="{StaticResource TextPrimary}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="Date" Foreground="{StaticResource TextMuted}"
                           FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"/>
                <Border x:Name="WeatherSeparator" Width="1" Height="14" Margin="11,0"
                        Background="{StaticResource Hairline}" VerticalAlignment="Center"/>
                <TextBlock x:Name="PillGlyph" FontFamily="Segoe UI Emoji"
                           Foreground="{StaticResource TextPrimary}" FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="PillTemperature" Foreground="{StaticResource TextPrimary}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="6,0,0,0"/>
                <Border x:Name="BatterySeparator" Width="1" Height="14" Margin="11,0"
                        Background="{StaticResource Hairline}" VerticalAlignment="Center"/>
                <TextBlock x:Name="BatteryGlyph" Style="{StaticResource IconFont}"
                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                <TextBlock x:Name="Battery" Foreground="{StaticResource TextMuted}"
                           FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tocando agora -->
        <Border x:Name="MediaCard" Style="{StaticResource CardShell}" Margin="0,0,0,10"
                MouseLeftButtonUp="Media_Click">
            <StackPanel>
                <TextBlock Text="Tocando agora" Style="{StaticResource CardLabel}" Margin="0,0,0,13"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" Background="#FF1F1F1F">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,46,46" RadiusX="10" RadiusY="10"/>
                        </Border.Clip>
                        <Grid>
                            <TextBlock Text="&#xE768;" Style="{StaticResource IconFont}"
                                       FontSize="20" Foreground="#FF4A4A4A"/>
                            <Image x:Name="Artwork" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0">
                        <TextBlock x:Name="TrackTitle" Foreground="White" FontSize="13.5"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TrackArtist" Foreground="{StaticResource TextMuted}"
                                   FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE892;" Style="{StaticResource MediaButton}"
                                   MouseLeftButtonUp="Previous_Click"/>
                        <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;"
                                   Style="{StaticResource MediaButtonPrimary}"
                                   MouseLeftButtonUp="PlayPause_Click"/>
                        <TextBlock Text="&#xE893;" Style="{StaticResource MediaButton}"
                                   MouseLeftButtonUp="Next_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Height="3" Margin="0,14,0,6">
                    <Border CornerRadius="2" Background="#FF2B2B2B"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="TrackDone" Width="0*"/>
                            <ColumnDefinition x:Name="TrackLeft" Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="2" Background="#FFE8E8E8"/>
                    </Grid>
                </Grid>

                <Grid>
                    <TextBlock x:Name="Elapsed" Style="{StaticResource MetricCaption}"
                               FontSize="10.5" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="Total" Style="{StaticResource MetricCaption}"
                               FontSize="10.5" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Agenda -->
        <Border x:Name="AgendaCard" Style="{StaticResource CardShell}" Margin="0,0,0,10"
                MouseLeftButtonUp="Agenda_Click">
            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <TextBlock Text="Agenda" Style="{StaticResource CardLabel}"
                               HorizontalAlignment="Left"/>
                    <StackPanel x:Name="AccountRow" Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Border Width="15" Height="15" CornerRadius="3" Background="White"
                                BorderBrush="{StaticResource Google}" BorderThickness="1.5">
                            <TextBlock x:Name="IconDay" Foreground="{StaticResource Google}"
                                       FontSize="8.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Account" Style="{StaticResource MetricCaption}"
                                   FontSize="10.5" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="NoEvents" Text="Nada marcado para hoje"
                           Foreground="#FF5A5A5A" FontSize="11.5" Visibility="Collapsed"/>

                <Grid x:Name="Timeline">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="9" Margin="0,3,13,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Ellipse x:Name="NowDot" Grid.Row="0" Width="9" Height="9"
                                 Fill="{StaticResource Google}"/>
                        <Border x:Name="TimelineStem" Grid.Row="1" Width="1.5" Margin="0,4"
                                Background="#FF232323"/>
                        <Ellipse x:Name="NextDot" Grid.Row="2" Width="9" Height="9"
                                 Stroke="#FF3A3A3A" StrokeThickness="1.5"/>
                    </Grid>

                    <StackPanel Grid.Column="1">
                        <StackPanel x:Name="NowBlock">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NowBadge" Foreground="{StaticResource Google}"
                                           FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NowRange" Style="{StaticResource MetricCaption}"
                                           FontSize="10.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="NowTitle" Foreground="White" FontSize="13"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            <Grid x:Name="NowProgress" Height="2.5" Margin="0,9,0,16">
                                <Border CornerRadius="2" Background="#FF232323"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="NowDone" Width="0*"/>
                                        <ColumnDefinition x:Name="NowLeft" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2"
                                            Background="{StaticResource Google}"/>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="NextBlock">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NextTime" Foreground="{StaticResource TextMuted}"
                                           FontSize="11"/>
                                <TextBlock x:Name="NextIn" Style="{StaticResource MetricCaption}"
                                           FontSize="10.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="NextTitle" Foreground="#FFBFBFBF" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tempo -->
            <Border x:Name="WeatherCard" Grid.Column="0" Style="{StaticResource CardShell}"
                    MouseLeftButtonUp="Weather_Click">
                <StackPanel>
                    <TextBlock Text="Tempo" Style="{StaticResource CardLabel}" Margin="0,0,0,11"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="WeatherGlyph" FontFamily="Segoe UI Emoji"
                                   Foreground="{StaticResource TextPrimary}" FontSize="27"
                                   VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Temperature" Foreground="White" FontSize="27"
                                       FontWeight="Light"/>
                            <TextBlock x:Name="Condition" Style="{StaticResource MetricCaption}"
                                       FontSize="10.5" TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,14,0,11"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sensação" Style="{StaticResource MetricCaption}"/>
                            <TextBlock x:Name="FeelsLike" Style="{StaticResource Metric}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Umidade" Style="{StaticResource MetricCaption}"/>
                            <TextBlock x:Name="Humidity" Style="{StaticResource Metric}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Vento" Style="{StaticResource MetricCaption}"/>
                            <TextBlock x:Name="Wind" Style="{StaticResource Metric}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sistema -->
            <Border x:Name="SystemCard" Grid.Column="2" Style="{StaticResource CardShell}"
                    MouseLeftButtonUp="System_Click">
                <StackPanel>
                    <TextBlock Text="Sistema" Style="{StaticResource CardLabel}" Margin="0,0,0,13"/>

                    <Grid Margin="0,0,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CPU" Style="{StaticResource MetricCaption}"
                                   VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Height="4" VerticalAlignment="Center">
                            <Border CornerRadius="2" Background="#FF2B2B2B"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CpuDone" Width="0*"/>
                                    <ColumnDefinition x:Name="CpuLeft" Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CpuBar" Grid.Column="0" CornerRadius="2"/>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="CpuValue" Grid.Column="2" Style="{StaticResource Metric}"
                                   FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RAM" Style="{StaticResource MetricCaption}"
                                   VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Height="4" VerticalAlignment="Center">
                            <Border CornerRadius="2" Background="#FF2B2B2B"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="RamDone" Width="0*"/>
                                    <ColumnDefinition x:Name="RamLeft" Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="RamBar" Grid.Column="0" CornerRadius="2"/>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="RamValue" Grid.Column="2" Style="{StaticResource Metric}"
                                   FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GPU" Style="{StaticResource MetricCaption}"
                                   VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Height="4" VerticalAlignment="Center">
                            <Border CornerRadius="2" Background="#FF2B2B2B"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="GpuDone" Width="0*"/>
                                    <ColumnDefinition x:Name="GpuLeft" Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="GpuBar" Grid.Column="0" CornerRadius="2"/>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="GpuValue" Grid.Column="2" Style="{StaticResource Metric}"
                                   FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Volume" Style="{StaticResource MetricCaption}"
                                   VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Height="4" VerticalAlignment="Center">
                            <Border CornerRadius="2" Background="#FF2B2B2B"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="VolumeDone" Width="0*"/>
                                    <ColumnDefinition x:Name="VolumeLeft" Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="VolumeBar" Grid.Column="0" CornerRadius="2"/>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="VolumeValue" Grid.Column="2" Style="{StaticResource Metric}"
                                   FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>
