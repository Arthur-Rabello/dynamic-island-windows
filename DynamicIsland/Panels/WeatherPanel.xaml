<UserControl x:Class="DynamicIsland.Panels.WeatherPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <Grid Margin="16,2,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="LocationLabel"
                       Text="Carregando…"
                       Style="{StaticResource PanelTitle}"
                       HorizontalAlignment="Left"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="RefreshButton"
                       Text="&#xE72C;"
                       Style="{StaticResource MediaButton}"
                       HorizontalAlignment="Right"
                       ToolTip="Atualizar"
                       MouseLeftButtonUp="Refresh_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ConditionGlyph"
                       Grid.Column="0"
                       Text="&#x2601;"
                       FontFamily="Segoe UI Emoji"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="34"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="Temperature"
                       Grid.Column="1"
                       Text="--°"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="36"
                       FontWeight="Light"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0"/>

            <TextBlock x:Name="Description"
                       Grid.Column="2"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="14,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Sensação" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="FeelsLike" Text="--°" Style="{StaticResource StatValue}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Umidade" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="Humidity" Text="--%" Style="{StaticResource StatValue}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Vento" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="Wind" Text="--" Style="{StaticResource StatValue}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="ForecastSection" Grid.Row="3" Visibility="Collapsed">
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,15,0,12"/>
            <primitives:UniformGrid x:Name="Days" Rows="1"/>
        </StackPanel>

    </Grid>
</UserControl>
