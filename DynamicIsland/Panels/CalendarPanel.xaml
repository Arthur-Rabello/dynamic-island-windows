<UserControl x:Class="DynamicIsland.Panels.CalendarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <Grid Margin="16,2,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- month navigation -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="MonthLabel"
                       Style="{StaticResource PanelTitle}"
                       HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="&#xE76B;"
                           Style="{StaticResource MediaButton}"
                           MouseLeftButtonUp="PreviousMonth_Click"/>
                <TextBlock Text="&#xE823;"
                           Style="{StaticResource MediaButton}"
                           ToolTip="Hoje"
                           MouseLeftButtonUp="Today_Click"/>
                <TextBlock Text="&#xE76C;"
                           Style="{StaticResource MediaButton}"
                           MouseLeftButtonUp="NextMonth_Click"/>
            </StackPanel>
        </Grid>

        <primitives:UniformGrid x:Name="WeekdayHeader" Grid.Row="1" Columns="7" Margin="0,0,0,4"/>

        <primitives:UniformGrid x:Name="DayGrid" Grid.Row="2" Columns="7"/>

        <StackPanel x:Name="EventSection" Grid.Row="3" Margin="0,12,0,0">
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,0,0,9"/>
            <TextBlock x:Name="EventHeading"
                       Style="{StaticResource StatLabel}"
                       Margin="0,0,0,6"/>
            <StackPanel x:Name="EventList"/>
        </StackPanel>

    </Grid>
</UserControl>
