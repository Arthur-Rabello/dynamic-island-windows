<UserControl x:Class="DynamicIsland.Panels.VolumePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16,4,16,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="Glyph"
                   Grid.Column="0"
                   Style="{StaticResource MediaButton}"
                   FontSize="16"
                   Foreground="White"
                   ToolTip="Silenciar"
                   MouseLeftButtonUp="Mute_Click"/>

        <!-- The transparent 26px row is the hit area; the visible bar is only 6px -->
        <Grid x:Name="Bar"
              Grid.Column="1"
              Height="26"
              Margin="8,0,12,0"
              Background="Transparent"
              Cursor="Hand"
              MouseLeftButtonDown="Bar_MouseDown"
              MouseMove="Bar_MouseMove"
              MouseLeftButtonUp="Bar_MouseUp">
            <Grid Height="6" IsHitTestVisible="False">
                <Border CornerRadius="3" Background="{StaticResource Track}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="Done" Width="0*"/>
                        <ColumnDefinition x:Name="Left" Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Fill" Grid.Column="0" CornerRadius="3" Background="White"/>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock x:Name="Value"
                   Grid.Column="2"
                   Style="{StaticResource StatValue}"
                   TextAlignment="Right"
                   Width="42"/>
    </Grid>
</UserControl>
